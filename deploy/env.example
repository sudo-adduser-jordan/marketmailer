# Copy to ~/.config/marketmailer/env (NOT into the repo) and fill in:
#   cp deploy/env.example ~/.config/marketmailer/env
# Sourced by deploy/marketmailer.service via EnvironmentFile=.
MARKETMAILER_COOKIE=change-me-see-task-live-cookie
MARKETMAILER_DB=/absolute/path/to/marketmailer.db
DISCORD_TOKEN=
