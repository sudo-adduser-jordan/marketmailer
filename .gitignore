# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
marketmailer-*.tar

.elixir_ls

.env

# sqlite database files (live + test defaults under priv/data/)
/priv/data/*.db
/priv/data/*.db-shm
/priv/data/*.db-wal
!/priv/data/.gitkeep

# SDE snapshot downloads (reproducible from developers.eveonline.com)
/priv/data/sde/

# dev poller pidfile (runtime state written by `task start`)
/priv/data/marketmailer.pid

# structured JSON logs (errors.jsonl + rotated archives)
/logs/

# Castle release artifacts and baselines (shipped tarballs staged for upgrades)
# Directory itself is kept; tarballs stay out of git (CI artifact storage).
/artifacts/*
!/artifacts/.gitkeep
/_build/castle/baselines/
