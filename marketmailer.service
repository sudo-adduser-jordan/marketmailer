# Template user unit: keeps one marketmailer poller always running.
# Created in-repo only — copy to ~/.config/systemd/user/ and adjust paths,
# then: systemctl --user daemon-reload && systemctl --user enable --now marketmailer
# Stop (the only intended off switch): systemctl --user stop marketmailer
# NOTE: adjust paths to this repo's checkout on the target machine, then
# `MIX_ENV=prod mix release` once so the release exists.
[Unit]
Description=marketmailer EVE market poller (always on unless stopped)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Documents/GitHub/marketmailer
EnvironmentFile=-%h/.config/marketmailer/env
# Release distribution + app config come from the EnvironmentFile:
#   RELEASE_DISTRIBUTION=sname
#   RELEASE_NODE=marketmailer
#   MARKETMAILER_DB=/absolute/path/marketmailer.db (defaults to /data/marketmailer.db in containers, ./priv/data/marketmailer.db under mix)
#   DISCORD_TOKEN=... (bot is skipped with a warning when missing/invalid)
# Restart=on-failure is required: Castle `restart_emulator` upgrades exit the
# emulator and rely on the supervisor to start the new version.
ExecStart=%h/Documents/GitHub/marketmailer/_build/prod/rel/marketmailer/bin/marketmailer foreground
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
