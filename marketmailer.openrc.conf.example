# Copy to /etc/conf.d/marketmailer and adjust. Sourced by OpenRC
# (/etc/init.d/marketmailer) and equivalent to the systemd EnvironmentFile
# (~/.config/marketmailer/env).

# Distribution (release launcher reads these; the deployment cookie in
# releases/COOKIE is managed automatically — nothing to copy).
RELEASE_DISTRIBUTION="sname"
RELEASE_NODE="marketmailer"

# App config.
MARKETMAILER_DB="/var/lib/marketmailer/marketmailer.db"
DISCORD_TOKEN=""

# Where the checkout lives (overrides the default in marketmailer.openrc).
MARKETMAILER_HOME="/opt/marketmailer-checkout"
