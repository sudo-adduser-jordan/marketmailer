#!/sbin/openrc-run
# OpenRC service for the marketmailer Castle release.
# Copy to /etc/init.d/marketmailer (chmod +x), then:
#   rc-update add marketmailer default
#   rc-service marketmailer start
# Stop (the only intended off switch): rc-service marketmailer stop
#
# Configuration lives in /etc/conf.d/marketmailer (RELEASE_DISTRIBUTION,
# RELEASE_NODE, MARKETMAILER_DB, DISCORD_TOKEN). See
# ./marketmailer.openrc.conf.example for the full list.

name="marketmailer"
description="marketmailer EVE market poller (Castle release, always on unless stopped)"

: "${MARKETMAILER_HOME:=/opt/marketmailer-checkout}"
command="${MARKETMAILER_HOME}/_build/prod/rel/marketmailer/bin/marketmailer"
command_args="foreground"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"

# `restart_emulator` upgrades exit the emulator; respawn brings up the new
# version, mirroring systemd `Restart=on-failure`.
respawn_delay=5
respawn_max=0

depend() {
	need net
	after net
}

start_pre() {
	if [ ! -x "${command}" ]; then
		eerror "release binary not found: ${command} (run MIX_ENV=prod mix release first)"
		return 1
	fi
	checkpath --directory --owner "${command_user:-root}" /run 2>/dev/null || true
}
