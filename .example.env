# Minimal .env: only the Discord token is required. Everything else has
# built-in defaults, so leave the lines below commented out unless you need
# to override them. NOTE: an empty `export VAR=""` does NOT fall back to the
# default — it overrides it with an empty value — so either set a real value
# or leave the line commented out.
export DISCORD_TOKEN=""

# SQLite path. Single-host prod keeps the database in the project
# (recommended: the same warm priv/data file dev uses). Containers keep
# /data/marketmailer.db, bind-mounted to ./priv/data by `task docker:run`.
# export MARKETMAILER_DB="priv/data/marketmailer.db"

# Release-only (`task dev` does not need these): distribution
# settings for the prod OTP release (no cookie management:
# bin/marketmailer and bin/castle read releases/COOKIE themselves).
# export RELEASE_DISTRIBUTION="sname"
# export RELEASE_NODE="marketmailer"

# Phoenix LiveDashboard at /dashboard (prod :4000 on the host; `task dev`
# defaults to http://localhost:4001/dashboard so it coexists with prod).
# No env vars needed: without
# SECRET_KEY_BASE the dashboard boots with an ephemeral per-boot secret.
# Only set these to override defaults (basic auth is off unless BOTH
# user and password are set).
# export SECRET_KEY_BASE=""
# export DASHBOARD_USER=""
# export DASHBOARD_PASSWORD=""
# export DASHBOARD_PORT="4000"
# export DASHBOARD_ENABLED="true"

# `task dev` isolation (all optional): dev ignores .env's MARKETMAILER_DB /
# DISCORD_TOKEN and defaults to priv/data/dev.db + :4001 with no bot, so
# plain `task dev` is safe alongside the prod daemon. Set these to opt out:
# MARKETMAILER_DEV_DB=priv/data/marketmailer.db reuses the live file
# (refused while the daemon holds it); DEV_DISCORD_TOKEN connects the dev
# bot (steals prod's gateway); START_POLLERS=false skips ESI polling.
# export MARKETMAILER_DEV_DB="priv/data/dev.db"
# export DEV_DISCORD_TOKEN=""
# export START_POLLERS="true"
