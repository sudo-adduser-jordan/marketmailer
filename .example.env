# Minimal .env: only the Discord token is required. Everything else has
# built-in defaults, so leave the lines below commented out unless you need
# to override them. NOTE: an empty `export VAR=""` does NOT fall back to the
# default — it overrides it with an empty value — so either set a real value
# or leave the line commented out.
export DISCORD_TOKEN=""

# SQLite path. Single-host prod keeps the database in the project
# (recommended: the same warm priv/data file dev uses). Containers keep
# /data/marketmailer.db, bind-mounted to ./priv/data by `task docker:run`.
# export MARKETMAILER_DB="priv/data/marketmailer.db"

# Release-only (`task dev` does not need these): distribution
# settings for the prod OTP release (no cookie management:
# bin/marketmailer and bin/castle read releases/COOKIE themselves).
# export RELEASE_DISTRIBUTION="sname"
# export RELEASE_NODE="marketmailer"
